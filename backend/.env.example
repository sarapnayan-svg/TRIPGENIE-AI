# ==============================================================================
# TRIPGENIE AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in the values below for your deployment environment.
# 3. NEVER commit your actual .env file to version control.
# ==============================================================================

# [REQUIRED] Anthropic Claude API Key for RAG Synthesis & Chat
# Obtain key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# [OPTIONAL] LLM Model Specification (default: claude-3-5-sonnet-20241022)
LLM_MODEL=claude-3-5-sonnet-20241022

# [OPTIONAL] Semantic Search Embedding Model (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RESULTS=6

# [OPTIONAL] Weather API Key (e.g. OpenWeatherMap)
# If omitted or left empty, TripGenie AI uses the free WMO Open-Meteo Meteorological API
WEATHER_API_KEY=

# [OPTIONAL] Database Connection String (PostgreSQL or persistent SQLite)
# For production (Render / Railway / Supabase PostgreSQL):
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/dbname
# If omitted, defaults to persistent SQLite at sqlite:///./tripgenie.db
DATABASE_URL=sqlite:///./tripgenie.db

# [OPTIONAL] JWT Secret Key for user authentication sessions
# Use a 32+ character random string in production: openssl rand -hex 32
JWT_SECRET=your-random-32-character-secret-key-here

# [OPTIONAL] CORS Allowed Origins
# Comma-separated list of allowed frontend domains in production.
# Example: https://tripgenie.vercel.app,https://your-domain.com
# If left empty, allows all origins (*)
CORS_ORIGINS=

# [OPTIONAL] Server Network Binding (configured automatically by cloud hosts)
HOST=0.0.0.0
PORT=8000
